       IDENTIFICATION DIVISION.
       PROGRAM-ID. CBACT01C.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCT-FILE ASSIGN TO ACCTDAT
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS ACCT-KEY.
       DATA DIVISION.
       FILE SECTION.
       FD  ACCT-FILE.
       01  ACCT-REC.
           05 ACCT-KEY     PIC X(11).
           05 ACCT-DATA    PIC X(100).
       WORKING-STORAGE SECTION.
           COPY ACCTREC.
       01  WS-BALANCE      PIC S9(7)V99 COMP-3 VALUE 0.
       01  WS-STATUS       PIC X(2) VALUE '00'.
       EXEC SQL INCLUDE SQLCA END-EXEC.
       PROCEDURE DIVISION.
       0000-MAIN.
           EXEC CICS RECEIVE MAP('ACCTMAP') MAPSET('ACCTSET') END-EXEC.
           EXEC SQL
               SELECT BALANCE INTO :WS-BALANCE
               FROM ACCOUNT_TABLE
               WHERE ACCT_ID = :WS-ACCT-ID
           END-EXEC.
           IF SQLCODE = 0
               PERFORM 1000-UPDATE-ACCT
           END-IF.
           EXEC CICS SEND MAP('ACCTMAP') MAPSET('ACCTSET') END-EXEC.
           EXEC CICS RETURN END-EXEC.
       1000-UPDATE-ACCT.
           CALL 'CBCUS01C' USING WS-ACCT-ID WS-BALANCE.
           STOP RUN.
