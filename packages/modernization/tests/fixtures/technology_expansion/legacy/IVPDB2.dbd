       DBD   NAME=IVPDB2,ACCESS=(HDAM,VSAM),RMNAME=(DFSHDC40,1,500)
       DATASET DD1=IVPDB2D
       SEGM  NAME=CUSTOMER,BYTES=120,FREQ=1000,PARENT=0
       FIELD NAME=(CUSTID,SEQ,U),BYTES=10,START=1,TYPE=C
       FIELD NAME=CUSTNAME,BYTES=30,START=11,TYPE=C
       SEGM  NAME=ACCOUNT,BYTES=80,FREQ=2500,PARENT=((CUSTOMER,SNGL))
