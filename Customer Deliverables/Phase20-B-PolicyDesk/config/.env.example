# PolicyDesk Knowledge Assistant — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Persistent external runtime storage directory (Must be outside source repositories)
POLICYDESK_DATA_DIR=~/Library/Application Support/AutoForge/CustomerProjects/Phase20-B-PolicyDesk

# Server Port
POLICYDESK_PORT=8080

# Local or remote OpenAI-compatible LLM endpoint
POLICYDESK_LLM_URL=http://127.0.0.1:19801/v1

# Target Model Identifier
POLICYDESK_LLM_MODEL=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit-dwq-v2

# Model weights cache directory
POLICYDESK_MODEL_CACHE_DIR=~/Library/Caches/AutoForge/models
